# 复制为 .env 后逐项修改。.env 里是密码，不要提交到任何仓库。
#
# 说明：这些变量只影响 Docker 部署，不改变开发环境的任何配置。

# 部署模式：
#   split    分容器（默认）—— 每个组件独立容器，可单独重启/升级
#   allinone 单容器       —— 全部进程一个容器，只暴露一个端口，镜像较大
DEPLOY_MODE=split

# 部署目录的绝对路径（放 jar、data、logs、nginx、spsspro-dist 的那一层）
APP_HOME=/opt/energy-app

# 对外访问端口（浏览器只访问这一个端口，其余服务都在容器网络内）
HTTP_PORT=8090
# 设备侧 MQTT 端口（RTU / 物联网网关连这个端口上报）。
# 会映射到宿主机，被占用时改成 18830 之类；所有设备的连接地址要跟着改。
MQTT_PORT=1883
# RTU 现场固件（HaaS506-ED1）把 MQTT 端口写死成 11883。
# 平台额外监听这个端口，换机器/重装/换客户都不用重烧固件；留空表示不映射。
MQTT_RTU_PORT=11883

# 数据库
DB_NAME=thingsboard
DB_USER=postgres
DB_PASSWORD=请改成强密码

# ---- 遥测存储（时序数据）----
# sql                （小机器默认）遥测也存 Postgres 的 ts_kv，按月分区。
#                   千万行以内够用，省 2GB 内存、少一个容器、少一整类故障。
# cassandra          （≥10GB 内存默认）遥测存 Cassandra，Postgres 只存实体与最新值。
#                   需要额外 ~2GB 常驻内存，首次启动 2~5 分钟。
#
# 默认值由 docker-00-prepare.sh 按**宿主机物理内存**自动选：
#   < 10GB → sql（8GB 机器上 Cassandra 会被 Docker VM 挤压，commitlog 易损坏）
#   ≥ 10GB → cassandra
# 要强制指定：DATABASE_TS_TYPE=cassandra bash docker-00-prepare.sh
#
# ⚠ 改这个值不会迁移存量数据：切过去之后历史查不到（新数据才写新后端）。
#   空库部署随便切；有数据时先看手册「Cassandra」一节的迁移说明。
# ⚠ Cassandra 非优雅终止会损坏 commitlog（无限重启 + 平台 502）。
#   恢复用 scripts/12-cassandra-recover.sh；预防靠 compose 的 stop_grace_period。
DATABASE_TS_TYPE=sql
# 最新值（设备详情页、看板的实时数字）单独选。
# 建议留 sql：查询快、与实体同库、少一次跳库往返。
DATABASE_TS_LATEST_TYPE=sql

# 应用服务 JVM 堆上限（split 模式用 SERVER_HEAP）
SERVER_HEAP=2g
# 单容器模式的堆上限，单位 MB（allinone 模式用这个）
SERVER_HEAP_MB=2048

# 运行 profile：dev 为单机内嵌队列，已验证；pro 需要额外配置
# dev = 开发（日志只到控制台）；pro = 生产（日志按天落盘到 ./logs/）
# 生产部署请改成 pro，否则不会有文件日志。
SPRING_PROFILE=dev

# ---- spsspro 数据分析（数据探索 / 用能质量）----
# 镜像约 1.3GB（numpy/scipy/sklearn/catboost/shap 都在里面），
# 首次构建约 10~15 分钟（pip 下载 llvmlite 就占一半），之后有层缓存秒过。
SPSSPRO_IMAGE=energy/spsspro-backend:4.4.0
# 单容器镜像名（卸载时可选保留以节省二次构建时间）
ALLINONE_IMAGE=energy/allinone:4.4.0

# spsspro 访问 ThingsBoard 用的服务账号（读场站、设备、遥测）。
# 建议建一个 TENANT_ADMIN 账号填在这里，不要用系统管理员。
TB_API_USERNAME=tenant@thingsboard.org
TB_API_PASSWORD=tenant

# ── 对象存储（S3 兼容，SeaweedFS）─────────────────────────────
# 波形文件（问题详情）与技术工作台的数据集物化都用它。
# docker-00-prepare.sh 会自动生成随机密钥并同步写进 seaweedfs/s3.json，
# 两边必须一致 —— 不一致时写对象 403，页面上只表现为「不缓存」。
# 手工填的话记得两处都改：
#   S3_SECRET_KEY            → 本文件
#   identities[0].credentials[0].secretKey → ~/energy-app/seaweedfs/s3.json
S3_ACCESS_KEY=energy
S3_SECRET_KEY=
S3_BUCKET=energy-waveform
S3_GUARDIAN_BUCKET=energy-guardian

# ── 演示数据模拟器 ────────────────────────────────────────────
# 让演示表计持续上报，否则几小时后全部「数据陈旧」、抄表判 stale、账单空。
#
# ★ 默认 false，且**客户生产环境永远不要打开**：
#   它写的是假数据，看板上每个数字都是编的，而且不会有任何提示。
#   演示机才写 true。
#
# 打开后总览页会出现一条蓝色细条「演示数据模拟器运行中」，
# 让技术侧一眼看出这些数据是模拟的。也可以在页面上随时 停/启动。
SPSSPRO_SIMULATOR_ENABLED=false
# 上报间隔（秒）。60 = 每分钟一批。
SPSSPRO_SIMULATOR_INTERVAL=60
# 模拟哪个客户名下的设备。
SPSSPRO_SIMULATOR_CUSTOMER=平台演示中心

# ── 开户与初始化（内部工具，**不给客户用**）────────────────────
# /spsspro/guardian/onboard 能建租户、建客户、建账号，并核对演示数据。
# 它是交付时的一次性工具：客户侧菜单里不出现，也不该出现在对外环境。
#
# ★ 对外开放前必须做的两件事（选一件即可）：
#     ① SPSSPRO_ONBOARD_ENABLED=false   —— 整个接口 403
#     ② SPSSPRO_ONBOARD_TOKEN=<随机串>   —— 请求必须带 X-Onboard-Token
#
# 开发阶段明面放着：true，且不设口令。
# ── 技术分析工作台的身份校验 ────────────────────────────────────
# 「Trend 分析」菜单在租户端，客户菜单里没有 —— 但直接输地址仍能打开，
# 所以接口这层要校验：
#   tenant（默认）必须有平台令牌，且是租户管理员 / 系统管理员
#   soft          无令牌放行（记日志），有客户令牌仍拒绝 —— 本地调试用
#   off           不校验 —— 只在不联网的开发机上用
#
# ★ 对外开放前不要留 soft / off。客户清空 localStorage 就能绕过 soft。
SPSSPRO_GUARDIAN_AUTH=tenant

# ── 开户与初始化（内部工具，不给客户用）────────────────────────
SPSSPRO_ONBOARD_ENABLED=true
# 内部访问口令。非空时页面「高级」里要填同样的值。留空 = 不校验。
SPSSPRO_ONBOARD_TOKEN=
# 平台系统管理员（建租户必须 SYS_ADMIN）。留空则回落到 TB_ADMIN_USER/PASS。
SPSSPRO_ONBOARD_ADMIN_USER=
SPSSPRO_ONBOARD_ADMIN_PASS=
# 系统管理员账号。开户专用，平时的数据读取不读它（用上面的 TB_API_USERNAME）。
# 这里是空值 —— 装了就要填，否则开户页会提示「服务端未配置管理员凭据」，
# 到页面「高级」里手填也能跑。
TB_ADMIN_USER=
TB_ADMIN_PASS=

