# 复制为 .env 后逐项修改。.env 里是密码，不要提交到任何仓库。
#
# 说明：这些变量只影响 Docker 部署，不改变开发环境的任何配置。

# 部署模式：
#   split    分容器（默认）—— 每个组件独立容器，可单独重启/升级
#   allinone 单容器       —— 全部进程一个容器，只暴露一个端口，镜像较大
DEPLOY_MODE=split

# 部署目录的绝对路径（放 jar、data、logs、nginx、ngxai-dist 的那一层）
APP_HOME=/opt/energy-app

# 对外访问端口（浏览器只访问这一个端口，其余服务都在容器网络内）
HTTP_PORT=8090
# 设备侧 MQTT 端口（RTU / 物联网网关连这个端口上报）。
# 会映射到宿主机，被占用时改成 18830 之类；所有设备的连接地址要跟着改。
MQTT_PORT=1883
# RTU 现场固件（HaaS506-ED1）把 MQTT 端口写死成 11883。
# 平台额外监听这个端口，换机器/重装/换客户都不用重烧固件；留空表示不映射。
MQTT_RTU_PORT=11883

# 数据库
DB_NAME=thingsboard
DB_USER=postgres
DB_PASSWORD=请改成强密码

# ---- 遥测存储（时序数据）----
# sql                （小机器默认）遥测也存 Postgres 的 ts_kv，按月分区。
#                   千万行以内够用，省 2GB 内存、少一个容器、少一整类故障。
# cassandra          （≥10GB 内存默认）遥测存 Cassandra，Postgres 只存实体与最新值。
#                   需要额外 ~2GB 常驻内存，首次启动 2~5 分钟。
#
# 默认值由 docker-00-prepare.sh 按**宿主机物理内存**自动选：
#   < 10GB → sql（8GB 机器上 Cassandra 会被 Docker VM 挤压，commitlog 易损坏）
#   ≥ 10GB → cassandra
# 要强制指定：DATABASE_TS_TYPE=cassandra bash docker-00-prepare.sh
#
# ⚠ 改这个值不会迁移存量数据：切过去之后历史查不到（新数据才写新后端）。
#   空库部署随便切；有数据时先看手册「Cassandra」一节的迁移说明。
# ⚠ Cassandra 非优雅终止会损坏 commitlog（无限重启 + 平台 502）。
#   恢复用 scripts/12-cassandra-recover.sh；预防靠 compose 的 stop_grace_period。
DATABASE_TS_TYPE=sql
# 最新值（设备详情页、看板的实时数字）单独选。
# 建议留 sql：查询快、与实体同库、少一次跳库往返。
DATABASE_TS_LATEST_TYPE=sql

# 应用服务 JVM 堆上限（split 模式用 SERVER_HEAP）
SERVER_HEAP=2g
# 单容器模式的堆上限，单位 MB（allinone 模式用这个）
SERVER_HEAP_MB=2048

# 运行 profile：dev 为单机内嵌队列，已验证；pro 需要额外配置
# dev = 开发（日志只到控制台）；pro = 生产（日志按天落盘到 ./logs/）
# 生产部署请改成 pro，否则不会有文件日志。
SPRING_PROFILE=dev

# ---- ngx-ai 分析服务 ----
# 后端镜像名（卸载时可选择性删除这个镜像以节省二次部署时间）
AI_IMAGE=energy/ngxai-backend:4.4.0
# 单容器镜像名（卸载时可选保留以节省二次构建时间）
ALLINONE_IMAGE=energy/allinone:4.4.0

# ngx-ai 访问 ThingsBoard 用的服务账号。
# 建议建一个 TENANT_ADMIN 账号填在这里，不要用系统管理员。
TB_API_USERNAME=tenant@thingsboard.org
TB_API_PASSWORD=tenant
